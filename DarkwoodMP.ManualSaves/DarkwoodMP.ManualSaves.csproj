<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\DarkwoodMP.Mod\GamePath.local.props" Condition="Exists('..\DarkwoodMP.Mod\GamePath.local.props')" />
  <Import Project="GamePath.local.props" Condition="Exists('GamePath.local.props')" />

  <!-- Optional add-on to YokWare Branch: manual save slots (F3). Needs DarkwoodMP.Mod.dll beside it.
       dotnet build -c Release
       dotnet build -c Release -p:Loader=MelonLoader -->
  <PropertyGroup>
    <Loader Condition="'$(Loader)' == ''">BepInEx</Loader>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Darkwood</GameDir>
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == '' and Exists('$(GameDir)\MelonLoader\net35\MelonLoader.dll')">$(GameDir)\MelonLoader\net35</MelonLoaderDir>
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == ''">$(MSBuildThisFileDirectory)..\libs\MelonLoader</MelonLoaderDir>

    <TargetFramework>net471</TargetFramework>
    <AssemblyName>YokWare.ManualSaves</AssemblyName>
    <RootNamespace>YokWare.ManualSaves</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>
    <OutputPath>bin\$(Configuration)\$(Loader)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Loader)' == 'BepInEx'">
    <DefineConstants>$(DefineConstants);BEPINEX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Loader)' == 'MelonLoader'">
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The co-op mod: menu screens, save rules, crash-safe save copy. Never copied next to this DLL. -->
  <ItemGroup>
    <ProjectReference Include="..\DarkwoodMP.Mod\DarkwoodMP.Mod.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'BepInEx'">
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'MelonLoader'">
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Darkwood_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameDir)\Darkwood_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Darkwood_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Darkwood_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Darkwood_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Darkwood_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGameDirs" AfterTargets="Build" Condition="'$(Loader)' == 'BepInEx' and '$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <SteamPlugins>$(GameDir)\BepInEx\plugins</SteamPlugins>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SteamPlugins)" Condition="Exists('$(SteamPlugins)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SecondPlugins)" Condition="'$(SecondPlugins)' != '' and Exists('$(SecondPlugins)')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThirdPlugins)" Condition="'$(ThirdPlugins)' != '' and Exists('$(ThirdPlugins)')" ContinueOnError="true" />
  </Target>

</Project>
