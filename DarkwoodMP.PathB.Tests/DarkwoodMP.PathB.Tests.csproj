<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Matches the shipped mod (Nullable disabled); the linked sources are not annotated. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>DarkwoodMP.PathB.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Compile shipped pure helpers without Unity/game references. -->
  <ItemGroup>
    <Compile Include="..\DarkwoodMP.Mod\Core\CoopPolicy.cs" Link="Shipped\CoopPolicy.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Core\CoopPolicy.NpcNight.cs" Link="Shipped\CoopPolicy.NpcNight.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Core\CoopPolicy.Session.cs" Link="Shipped\CoopPolicy.Session.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Core\CoopPolicy.CombatDream.cs" Link="Shipped\CoopPolicy.CombatDream.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Domains\Dialogue\DialogTreeWireCodec.cs" Link="Shipped\DialogTreeWireCodec.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\NetWriter.cs" Link="Shipped\NetWriter.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\NetMessageType.cs" Link="Shipped\NetMessageType.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\ForwardableAttribute.cs" Link="Shipped\ForwardableAttribute.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Bootstrap\PluginInfo.cs" Link="Shipped\PluginInfo.cs" />
    <!-- Wire message structs. DreamMessages.cs touches a few game types: see Stubs\GameStubs.cs. -->
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\DreamMessages.cs" Link="Shipped\DreamMessages.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\LocationPadSlotMessages.cs" Link="Shipped\LocationPadSlotMessages.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Domains\World\OutsidePadSlots.Logic.cs" Link="Shipped\OutsidePadSlots.Logic.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\SessionSettingsMessages.cs" Link="Shipped\SessionSettingsMessages.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\SensorEffectMessages.cs" Link="Shipped\SensorEffectMessages.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\CombatMessages.cs" Link="Shipped\CombatMessages.cs" />
    <Compile Include="..\DarkwoodMP.Mod\Networking\Messages\PlayerMessages.cs" Link="Shipped\PlayerMessages.cs" />
  </ItemGroup>
</Project>
